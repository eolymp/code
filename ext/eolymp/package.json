{
  "name": "eolymp-code-eolymp",
  "displayName": "Eolymp",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "eolymp",
  "license": "MIT",
  "private": true,
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/eolymp/code"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "eolymp.eolymp-code"
  ],
  "main": "./extension.js",
  "contributes": {
    "authentication": [
      {
        "id": "eolymp",
        "label": "Eolymp"
      }
    ],
    "configuration": {
      "title": "Eolymp",
      "properties": {
        "eolymp.runtimes": {
          "type": "object",
          "description": "%setting.runtimes%",
          "default": {
            "cpp": [
              "cpp:23-gnu14",
              "cpp:20-gnu14"
            ],
            "py": [
              "python:3.14-python",
              "python:3.13-python",
              "python:3.11-pypy"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "l10n": "./l10n"
}
