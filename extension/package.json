{
  "name": "eolymp-code",
  "displayName": "Eolymp Code",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "eolymp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eolymp/code"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "eolympCode",
          "title": "%view.eolympCode%",
          "icon": "$(terminal)"
        }
      ],
      "activitybar": [
        {
          "id": "eolympCodeSidebar",
          "title": "%view.eolympCodeSidebar%",
          "icon": "$(symbol-event)"
        }
      ]
    },
    "views": {
      "eolympCode": [
        {
          "type": "webview",
          "id": "eolympCode.tests",
          "name": "%view.tests%"
        }
      ],
      "eolympCodeSidebar": [
        {
          "id": "eolympCode.problems",
          "name": "%view.problems%"
        }
      ]
    },
    "commands": [
      {
        "command": "eolympCode.run",
        "title": "%command.run%",
        "category": "Eolymp Code",
        "icon": "$(play)"
      },
      {
        "command": "eolympCode.runTests",
        "title": "%command.runTests%",
        "category": "Eolymp Code",
        "icon": "$(run-all)"
      },
      {
        "command": "eolympCode.newProblem",
        "title": "%command.newProblem%",
        "category": "Eolymp Code",
        "icon": "$(add)"
      },
      {
        "command": "eolympCode.newSolution",
        "title": "%command.newSolution%",
        "category": "Eolymp Code",
        "icon": "$(new-file)"
      },
      {
        "command": "eolympCode.newTest",
        "title": "%command.newTest%",
        "category": "Eolymp Code",
        "icon": "$(symbol-field)"
      },
      {
        "command": "eolympCode.renameProblem",
        "title": "%command.renameProblem%",
        "category": "Eolymp Code"
      },
      {
        "command": "eolympCode.checkSetup",
        "title": "%command.checkSetup%",
        "category": "Eolymp Code"
      },
      {
        "command": "eolympCode.openInput",
        "title": "%command.openInput%"
      },
      {
        "command": "eolympCode.openAnswer",
        "title": "%command.openAnswer%"
      },
      {
        "command": "eolympCode.addAnswer",
        "title": "%command.addAnswer%"
      },
      {
        "command": "eolympCode.showDiff",
        "title": "%command.showDiff%"
      },
      {
        "command": "eolympCode.markCorrect",
        "title": "%command.markCorrect%"
      },
      {
        "command": "eolympCode.debugTest",
        "title": "%command.debugTest%"
      },
      {
        "command": "eolympCode.deleteTest",
        "title": "%command.deleteTest%"
      },
      {
        "command": "eolympCode.addAsTest",
        "title": "%command.addAsTest%"
      },
      {
        "command": "eolympCode.renameTest",
        "title": "%command.renameTest%"
      },
      {
        "command": "eolympCode.renameSolution",
        "title": "%command.renameSolution%"
      },
      {
        "command": "eolympCode.deleteSolution",
        "title": "%command.deleteSolution%"
      },
      {
        "command": "eolympCode.newFile",
        "title": "%command.newFile%"
      },
      {
        "command": "eolympCode.stop",
        "title": "%command.stop%",
        "category": "Eolymp Code",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "eolympCode.run",
          "group": "navigation@0",
          "when": "(resourceLangId == cpp || resourceLangId == python) && !eolympCode.running"
        },
        {
          "command": "eolympCode.runTests",
          "group": "navigation@1",
          "when": "(resourceLangId == cpp || resourceLangId == python) && !eolympCode.running"
        },
        {
          "command": "eolympCode.stop",
          "group": "navigation@0",
          "when": "(resourceLangId == cpp || resourceLangId == python) && eolympCode.running"
        }
      ],
      "view/title": [
        {
          "command": "eolympCode.newProblem",
          "group": "navigation",
          "when": "view == eolympCode.problems"
        }
      ],
      "view/item/context": [
        {
          "command": "eolympCode.newSolution",
          "group": "inline@1",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.newTest",
          "group": "inline@2",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.newSolution",
          "group": "1@1",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.newTest",
          "group": "1@2",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.renameProblem",
          "group": "2@1",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.run",
          "group": "inline@1",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.runTests",
          "group": "inline@2",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.renameTest",
          "group": "1@1",
          "when": "view == eolympCode.problems && viewItem == test"
        },
        {
          "command": "eolympCode.deleteTest",
          "group": "2@1",
          "when": "view == eolympCode.problems && viewItem == test"
        },
        {
          "command": "eolympCode.run",
          "group": "1@1",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.runTests",
          "group": "1@2",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.renameSolution",
          "group": "2@1",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.deleteSolution",
          "group": "3@1",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.newFile",
          "group": "1@3",
          "when": "view == eolympCode.problems && viewItem == problem"
        }
      ],
      "commandPalette": [
        {
          "command": "eolympCode.newSolution",
          "when": "false"
        },
        {
          "command": "eolympCode.newTest",
          "when": "false"
        },
        {
          "command": "eolympCode.renameProblem",
          "when": "false"
        },
        {
          "command": "eolympCode.openInput",
          "when": "false"
        },
        {
          "command": "eolympCode.openAnswer",
          "when": "false"
        },
        {
          "command": "eolympCode.addAnswer",
          "when": "false"
        },
        {
          "command": "eolympCode.showDiff",
          "when": "false"
        },
        {
          "command": "eolympCode.markCorrect",
          "when": "false"
        },
        {
          "command": "eolympCode.debugTest",
          "when": "false"
        },
        {
          "command": "eolympCode.deleteTest",
          "when": "false"
        },
        {
          "command": "eolympCode.addAsTest",
          "when": "false"
        },
        {
          "command": "eolympCode.renameTest",
          "when": "false"
        },
        {
          "command": "eolympCode.renameSolution",
          "when": "false"
        },
        {
          "command": "eolympCode.deleteSolution",
          "when": "false"
        },
        {
          "command": "eolympCode.newFile",
          "when": "false"
        },
        {
          "command": "eolympCode.stop",
          "when": "eolympCode.running"
        }
      ],
      "webview/context": [
        {
          "command": "eolympCode.openInput",
          "group": "1@1",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        },
        {
          "command": "eolympCode.openAnswer",
          "group": "1@2",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && hasAnswer"
        },
        {
          "command": "eolympCode.addAnswer",
          "group": "1@2",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && !hasAnswer"
        },
        {
          "command": "eolympCode.showDiff",
          "group": "1@4",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && canDiff"
        },
        {
          "command": "eolympCode.markCorrect",
          "group": "1@3",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && canAccept"
        },
        {
          "command": "eolympCode.debugTest",
          "group": "1@5",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        },
        {
          "command": "eolympCode.deleteTest",
          "group": "2@1",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        },
        {
          "command": "eolympCode.addAsTest",
          "group": "1@1",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'run'"
        },
        {
          "command": "eolympCode.renameTest",
          "group": "1@6",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "eolympCode.run",
        "key": "f5",
        "when": "editorTextFocus && !inDebugMode && (editorLangId == cpp || editorLangId == python)"
      },
      {
        "command": "eolympCode.runTests",
        "key": "shift+f5",
        "when": "editorTextFocus && !inDebugMode && (editorLangId == cpp || editorLangId == python)"
      }
    ],
    "configuration": {
      "title": "Eolymp Code",
      "properties": {
        "eolympCode.cxx": {
          "type": "string",
          "default": "g++",
          "description": "%setting.cxx%",
          "scope": "machine"
        },
        "eolympCode.cxxFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-std=c++17",
            "-O2",
            "-Wall"
          ],
          "description": "%setting.cxxFlags%",
          "scope": "machine"
        },
        "eolympCode.includePath": {
          "type": "string",
          "default": "",
          "description": "%setting.includePath%",
          "scope": "machine"
        },
        "eolympCode.python": {
          "type": "string",
          "default": "",
          "description": "%setting.python%",
          "scope": "machine"
        },
        "eolympCode.language": {
          "type": "string",
          "enum": [
            "cpp",
            "py"
          ],
          "default": "cpp",
          "description": "%setting.language%"
        },
        "eolympCode.timeLimit": {
          "type": "number",
          "default": 5000,
          "description": "%setting.timeLimit%"
        },
        "eolympCode.companionPort": {
          "type": "number",
          "default": 27121,
          "description": "%setting.companionPort%",
          "scope": "machine"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "eolympCode.problems",
        "contents": "%welcome.0%",
        "when": "workbenchState != empty"
      },
      {
        "view": "eolympCode.problems",
        "contents": "%welcome.1%",
        "when": "workbenchState == empty"
      }
    ],
    "configurationDefaults": {
      "workbench.colorCustomizations": {
        "[Dark 2026]": {
          "focusBorder": "#39BCB0B3",
          "textLink.foreground": "#48C7BC",
          "textLink.activeForeground": "#53CABF",
          "button.background": "#29A095",
          "button.hoverBackground": "#2BA398",
          "button.border": "#29A095",
          "inputValidation.infoBackground": "#1E4743",
          "inputValidation.infoBorder": "#39BCB0",
          "badge.background": "#309F95",
          "list.dropBackground": "#39BCB01A",
          "list.focusOutline": "#39BCB0B3",
          "list.highlightForeground": "#48C7BC",
          "activityBar.activeFocusBorder": "#39BCB0B3",
          "activityBarBadge.background": "#309F95",
          "menu.selectionBackground": "#39BCB026",
          "menu.selectionBorder": "#39BCB0",
          "editor.selectionBackground": "#27827ADD",
          "editor.inactiveSelectionBackground": "#27827A60",
          "editor.selectionHighlightBackground": "#27827A60",
          "editor.wordHighlightBackground": "#27827A50",
          "editor.wordHighlightStrongBackground": "#27827A80",
          "editor.findMatchBackground": "#27827A90",
          "editor.findMatchHighlightBackground": "#27827A80",
          "editorLink.activeForeground": "#3ABCB0",
          "editorBracketMatch.background": "#39BCB055",
          "editorSuggestWidget.focusOutline": "#39BCB0B3",
          "peekViewEditor.matchHighlightBackground": "#39BCB033",
          "peekViewResult.matchHighlightBackground": "#39BCB033",
          "peekViewResult.selectionBackground": "#39BCB026",
          "editorOverviewRuler.findMatchForeground": "#3ABCB099",
          "panelTitle.activeBorder": "#39BCB0",
          "statusBar.focusBorder": "#39BCB0B3",
          "statusBar.debuggingBackground": "#39BCB0",
          "statusBarItem.focusBorder": "#39BCB0B3",
          "statusBarItem.prominentBackground": "#39BCB0",
          "statusBarItem.prominentHoverBackground": "#39BCB0",
          "tab.activeBorderTop": "#39BCB0",
          "notificationLink.foreground": "#3ABCB0",
          "notificationsInfoIcon.foreground": "#3ABCB0",
          "extensionButton.prominentBackground": "#29A095",
          "extensionButton.prominentHoverBackground": "#2BA398",
          "quickInputList.focusBackground": "#29A095",
          "terminal.selectionBackground": "#39BCB033",
          "terminal.tab.activeBorder": "#39BCB000",
          "editorCommentsWidget.rangeBackground": "#48AEA526",
          "editorCommentsWidget.rangeActiveBackground": "#48AEA546"
        },
        "[Light 2026]": {
          "focusBorder": "#007E73",
          "textLink.foreground": "#007E73",
          "textLink.activeForeground": "#007E73",
          "button.background": "#007E73",
          "button.hoverBackground": "#00786D",
          "button.border": "#007E73",
          "inputValidation.infoBorder": "#007E73",
          "badge.background": "#007E73",
          "progressBar.background": "#007E73",
          "list.dropBackground": "#007E7315",
          "list.focusOutline": "#007E73",
          "list.highlightForeground": "#007E73",
          "activityBar.activeFocusBorder": "#007E73",
          "activityBarBadge.background": "#007E73",
          "menu.selectionBackground": "#007E731A",
          "menu.selectionBorder": "#007E73",
          "editor.selectionBackground": "#007E7340",
          "editor.inactiveSelectionBackground": "#007E731A",
          "editor.selectionHighlightBackground": "#007E7315",
          "editor.wordHighlightBackground": "#007E7326",
          "editor.wordHighlightStrongBackground": "#007E7326",
          "editor.findMatchBackground": "#007E7340",
          "editor.findMatchHighlightBackground": "#007E731A",
          "editorLink.activeForeground": "#007E73",
          "editorBracketMatch.background": "#007E7340",
          "editorSuggestWidget.highlightForeground": "#007E73",
          "editorSuggestWidget.focusOutline": "#007E73",
          "peekView.border": "#007E73",
          "peekViewEditor.matchHighlightBackground": "#007E7333",
          "peekViewResult.matchHighlightBackground": "#007E7333",
          "peekViewResult.selectionBackground": "#007E7326",
          "editorOverviewRuler.findMatchForeground": "#007E7399",
          "editorOverviewRuler.modifiedForeground": "#007E73",
          "statusBar.focusBorder": "#007E73",
          "statusBar.debuggingBackground": "#007E73",
          "statusBarItem.focusBorder": "#007E73",
          "statusBarItem.prominentBackground": "#007E73DD",
          "statusBarItem.prominentHoverBackground": "#007E73",
          "notificationLink.foreground": "#007E73",
          "notificationsInfoIcon.foreground": "#007E73",
          "extensionButton.prominentBackground": "#007E73",
          "extensionButton.prominentHoverBackground": "#007E73",
          "quickInputList.focusBackground": "#007E73",
          "terminal.selectionBackground": "#007E7326"
        }
      }
    }
  },
  "l10n": "./l10n",
  "icon": "icon.png"
}
