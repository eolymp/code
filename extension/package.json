{
  "name": "eolymp-code",
  "displayName": "Eolymp Code",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "eolymp",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/eolymp/code"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "enabledApiProposals": [
    "treeViewActiveItem"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "eolympCode",
          "title": "%view.eolympCode%",
          "icon": "$(terminal)"
        }
      ],
      "activitybar": [
        {
          "id": "eolympCodeSidebar",
          "title": "%view.eolympCodeSidebar%",
          "icon": "$(symbol-event)"
        }
      ]
    },
    "views": {
      "eolympCode": [
        {
          "type": "webview",
          "id": "eolympCode.tests",
          "name": "%view.tests%"
        }
      ],
      "eolympCodeSidebar": [
        {
          "id": "eolympCode.problems",
          "name": "%view.problems%"
        }
      ]
    },
    "commands": [
      {
        "command": "eolympCode.run",
        "title": "%command.run%",
        "category": "Eolymp Code",
        "icon": "$(play)"
      },
      {
        "command": "eolympCode.runTests",
        "title": "%command.runTests%",
        "category": "Eolymp Code",
        "icon": "$(run-all)"
      },
      {
        "command": "eolympCode.newProblem",
        "title": "%command.newProblem%",
        "category": "Eolymp Code",
        "icon": "$(add)"
      },
      {
        "command": "eolympCode.newSolution",
        "title": "%command.newSolution%",
        "category": "Eolymp Code",
        "icon": "$(new-file)"
      },
      {
        "command": "eolympCode.newTest",
        "title": "%command.newTest%",
        "category": "Eolymp Code",
        "icon": {
          "light": "new-test-light.svg",
          "dark": "new-test-dark.svg"
        }
      },
      {
        "command": "eolympCode.openInput",
        "title": "%command.openInput%"
      },
      {
        "command": "eolympCode.openAnswer",
        "title": "%command.openAnswer%"
      },
      {
        "command": "eolympCode.addAnswer",
        "title": "%command.addAnswer%"
      },
      {
        "command": "eolympCode.showDiff",
        "title": "%command.showDiff%"
      },
      {
        "command": "eolympCode.markCorrect",
        "title": "%command.markCorrect%"
      },
      {
        "command": "eolympCode.debugTest",
        "title": "%command.debugTest%"
      },
      {
        "command": "eolympCode.deleteTest",
        "title": "%command.deleteTest%"
      },
      {
        "command": "eolympCode.addAsTest",
        "title": "%command.addAsTest%"
      },
      {
        "command": "eolympCode.renameTest",
        "title": "%command.renameTest%"
      },
      {
        "command": "eolympCode.newFile",
        "title": "%command.newFile%"
      },
      {
        "command": "eolympCode.stop",
        "title": "%command.stop%",
        "category": "Eolymp Code",
        "icon": "$(debug-stop)"
      },
      {
        "command": "eolympCode.rename",
        "title": "%command.rename%"
      },
      {
        "command": "eolympCode.delete",
        "title": "%command.delete%"
      },
      {
        "command": "eolympCode.cut",
        "title": "%command.cut%"
      },
      {
        "command": "eolympCode.copy",
        "title": "%command.copy%"
      },
      {
        "command": "eolympCode.paste",
        "title": "%command.paste%"
      },
      {
        "command": "eolympCode.runTest",
        "title": "%command.runTest%",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "eolympCode.run",
          "group": "navigation@0",
          "when": "(resourceLangId == cpp || resourceLangId == python) && !eolympCode.running"
        },
        {
          "command": "eolympCode.runTests",
          "group": "navigation@1",
          "when": "(resourceLangId == cpp || resourceLangId == python) && !eolympCode.running"
        },
        {
          "command": "eolympCode.stop",
          "group": "navigation@0",
          "when": "(resourceLangId == cpp || resourceLangId == python) && eolympCode.running"
        },
        {
          "command": "eolympCode.runTest",
          "group": "navigation@0",
          "when": "(resourceExtname == .in || resourceExtname == .answer || resourceExtname == .out) && !eolympCode.running"
        }
      ],
      "view/title": [
        {
          "command": "eolympCode.newProblem",
          "group": "navigation",
          "when": "view == eolympCode.problems"
        }
      ],
      "view/item/context": [
        {
          "command": "eolympCode.newSolution",
          "group": "inline@1",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.newTest",
          "group": "inline@2",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.newSolution",
          "group": "1@1",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.newTest",
          "group": "1@2",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.run",
          "group": "inline@1",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.runTests",
          "group": "inline@2",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.run",
          "group": "1@1",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.runTests",
          "group": "1@2",
          "when": "view == eolympCode.problems && viewItem == solution"
        },
        {
          "command": "eolympCode.newFile",
          "group": "1@3",
          "when": "view == eolympCode.problems && viewItem == problem"
        },
        {
          "command": "eolympCode.rename",
          "group": "7_modification@1",
          "when": "view == eolympCode.problems"
        },
        {
          "command": "eolympCode.delete",
          "group": "7_modification@2",
          "when": "view == eolympCode.problems"
        },
        {
          "command": "eolympCode.cut",
          "group": "5_cutcopypaste@1",
          "when": "view == eolympCode.problems && viewItem != problem"
        },
        {
          "command": "eolympCode.copy",
          "group": "5_cutcopypaste@2",
          "when": "view == eolympCode.problems"
        },
        {
          "command": "eolympCode.paste",
          "group": "5_cutcopypaste@3",
          "when": "view == eolympCode.problems && eolympCode.canPaste"
        },
        {
          "command": "eolympCode.runTest",
          "group": "inline@1",
          "when": "view == eolympCode.problems && viewItem == test"
        },
        {
          "command": "eolympCode.runTest",
          "group": "1@1",
          "when": "view == eolympCode.problems && viewItem == test"
        }
      ],
      "commandPalette": [
        {
          "command": "eolympCode.newSolution",
          "when": "false"
        },
        {
          "command": "eolympCode.newTest",
          "when": "false"
        },
        {
          "command": "eolympCode.openInput",
          "when": "false"
        },
        {
          "command": "eolympCode.openAnswer",
          "when": "false"
        },
        {
          "command": "eolympCode.addAnswer",
          "when": "false"
        },
        {
          "command": "eolympCode.showDiff",
          "when": "false"
        },
        {
          "command": "eolympCode.markCorrect",
          "when": "false"
        },
        {
          "command": "eolympCode.debugTest",
          "when": "false"
        },
        {
          "command": "eolympCode.deleteTest",
          "when": "false"
        },
        {
          "command": "eolympCode.addAsTest",
          "when": "false"
        },
        {
          "command": "eolympCode.renameTest",
          "when": "false"
        },
        {
          "command": "eolympCode.newFile",
          "when": "false"
        },
        {
          "command": "eolympCode.stop",
          "when": "eolympCode.running"
        },
        {
          "command": "eolympCode.rename",
          "when": "false"
        },
        {
          "command": "eolympCode.delete",
          "when": "false"
        },
        {
          "command": "eolympCode.cut",
          "when": "false"
        },
        {
          "command": "eolympCode.copy",
          "when": "false"
        },
        {
          "command": "eolympCode.paste",
          "when": "false"
        },
        {
          "command": "eolympCode.runTest",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "eolympCode.openInput",
          "group": "1@1",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        },
        {
          "command": "eolympCode.openAnswer",
          "group": "1@2",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && hasAnswer"
        },
        {
          "command": "eolympCode.addAnswer",
          "group": "1@2",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && !hasAnswer"
        },
        {
          "command": "eolympCode.showDiff",
          "group": "1@4",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && canDiff"
        },
        {
          "command": "eolympCode.markCorrect",
          "group": "1@3",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test' && canAccept"
        },
        {
          "command": "eolympCode.debugTest",
          "group": "1@5",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        },
        {
          "command": "eolympCode.deleteTest",
          "group": "2@1",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        },
        {
          "command": "eolympCode.addAsTest",
          "group": "1@1",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'run'"
        },
        {
          "command": "eolympCode.renameTest",
          "group": "1@6",
          "when": "webviewId == 'eolympCode.tests' && webviewSection == 'test'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "eolympCode.run",
        "key": "f5",
        "when": "!inDebugMode && (editorTextFocus || focusedView == eolympCode.tests)"
      },
      {
        "command": "eolympCode.run",
        "key": "f5",
        "args": "focused",
        "when": "!inDebugMode && focusedView == eolympCode.problems && listFocus"
      },
      {
        "command": "eolympCode.runTests",
        "key": "shift+f5",
        "when": "!inDebugMode && (editorTextFocus || focusedView == eolympCode.tests)"
      },
      {
        "command": "eolympCode.runTests",
        "key": "shift+f5",
        "args": "focused",
        "when": "!inDebugMode && focusedView == eolympCode.problems && listFocus"
      },
      {
        "command": "eolympCode.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == eolympCode.problems && listFocus && !inputFocus"
      },
      {
        "command": "eolympCode.rename",
        "key": "f2",
        "mac": "enter",
        "when": "focusedView == eolympCode.problems && listFocus && !inputFocus"
      },
      {
        "command": "eolympCode.cut",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "focusedView == eolympCode.problems && listFocus && !inputFocus"
      },
      {
        "command": "eolympCode.copy",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "focusedView == eolympCode.problems && listFocus && !inputFocus"
      },
      {
        "command": "eolympCode.paste",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == eolympCode.problems && listFocus && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Eolymp Code",
      "properties": {
        "eolympCode.cxx": {
          "type": "string",
          "default": "g++",
          "description": "%setting.cxx%",
          "scope": "machine"
        },
        "eolympCode.cxxFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-std=c++17",
            "-O2",
            "-Wall"
          ],
          "description": "%setting.cxxFlags%",
          "scope": "machine"
        },
        "eolympCode.includePath": {
          "type": "string",
          "default": "",
          "description": "%setting.includePath%",
          "scope": "machine"
        },
        "eolympCode.python": {
          "type": "string",
          "default": "",
          "description": "%setting.python%",
          "scope": "machine"
        },
        "eolympCode.language": {
          "type": "string",
          "enum": [
            "cpp",
            "py"
          ],
          "default": "cpp",
          "description": "%setting.language%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "eolympCode.problems",
        "contents": "%welcome.0%",
        "when": "workbenchState != empty"
      },
      {
        "view": "eolympCode.problems",
        "contents": "%welcome.1%",
        "when": "workbenchState == empty"
      }
    ]
  },
  "l10n": "./l10n"
}
