{
  "name": "eolymp-code-setup",
  "displayName": "Eolymp Code Setup",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "eolymp",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/eolymp/code"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "eolymp.eolymp-code"
  ],
  "main": "./extension.js",
